{
  "name": "remit-lightning-complete",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @remit-complete/api\" \"npm run dev -w @remit-complete/web\"",
    "dev:web": "npm run dev -w @remit-complete/web",
    "dev:api": "npm run dev -w @remit-complete/api",
    "build": "npm run build -w @remit-complete/web && npm run build -w @remit-complete/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
